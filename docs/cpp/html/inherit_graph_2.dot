  Node0 -> Node5 [id="edge10_Node000000_Node000005",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node5 [id="Node000005",label="Triangle",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$classTriangle.html",tooltip="Classe représentant un triangle."];
